--- !u!114 &1878015756
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1878015755}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f2a6b65e71dd2cb43a8fe809ff3d8990, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSpeed: 0.15
  dialogueText: {fileID: 1835328955}
  dialogueRect: {fileID: 1674997698}
  dialogueDataList:
  - dialogueType: 0
    text:
    - "\uC6A9\uC0AC\uC5EC. \uBE5B\uC774 \uB2F9\uC2E0\uACFC \uD568\uAED8\uD569\uB2C8\uB2E4."
    - "\uC624\uB298\uC740 \uC5B4\uB5A4 \uBAA8\uD5D8\uC744 \uB5A0\uB098\uC2E4 \uAC74\uAC00\uC694?
      \uC544\uB9AC\uC2A4\uB294 \uD568\uAED8 \uB5A0\uB0A0 \uC900\uBE44\uAC00 \uB418\uC5B4\uC788\uC2B5\uB2C8\uB2E4."
    - "\uC5B4\uC11C \uC624\uC138\uC694, \uC120\uC0DD\uB2D8. \uC544\uB9AC\uC2A4, \uC120\uC0DD\uB2D8\uC744
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uC2E0\uC791 \uAC8C\uC784\uC774 \uACE7 \uBC1C\uB9E4\uB41C\uB300\uC694! \uC120\uC0DD\uB2D8\uB3C4
      \uAC19\uC774 \uD558\uC2E4 \uAC70\uC8E0?"
    - "\uC73C\uC74C, \uBC30\uAC00 \uACE0\uD515\uB2C8\uB2E4. \uC751\u2026? \uC544\uB9AC\uC2A4\uB294
      \uAC74\uC804\uC9C0\uB97C \uBA39\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!"
    - "\uC778\uAC04\uC774 \uC774\uACF3\uC5D0 \uC628 \uAC83\uC740 \uC218\uCC9C \uB144
      \uB9CC\uC774\uAD70\u2026. \uC660\uC9C0 \uC774\uB7F0 \uB300\uC0AC\uB97C \uD574\uBCF4\uACE0
      \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uC774\uC720\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC, \uC544\uB9AC\uC2A4\uB294
      \uB208\uBB3C\uC744 \uD758\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC544\uB9C8
      \uC548\uAD6C\uD615 \uCE74\uBA54\uB77C \uC138\uCC99\uC6A9\uC77C \uAC81\uB2C8\uB2E4."
    - "\uC120\uC0DD\uB2D8, \uB2E4\uC74C \uBAA9\uC801\uC9C0\uB294 \uC624\uB77D\uC2E4\u2026.
      \uC544, \uC544\uB9AC\uC2A4\uB294 \uAC70\uC9D3\uB9D0 \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!"
  - dialogueType: 1
    text:
    - "\uC544\uB9AC\uC2A4, \uD30C\uD2F0\uC5D0 \uD569\uB958\uD569\uB2C8\uB2E4."
    - "\uC81C \uC5ED\uD560\uC740, \uC5B4\uD0DC\uCEE4\uB85C\uAD70\uC694."
    - "\uAE30\uB3D9 \uC900\uBE44 \uC644\uB8CC."
    - "\uC804\uBC29\uC5D0 \uBAA9\uD45C \uD655\uC778. \uC804\uC9C4\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uC120\uC0DD\uB2D8, \uC9C0\uC2DC\uB97C."
  - dialogueType: 2
    text:
    - "\uC544\uB9AC\uC2A4\uAC00 \uC5EC\uAE30 \uC788\uC2B5\uB2C8\uB2E4. \uC544\uB9AC\uC2A4\uAC00
      \uB3D5\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uBE5B\uC774 \uC778\uB3C4\uD574\uC904 \uAC70\uC5D0\uC694."
    - "\uC6A9\uAE30, \uADF8\uAC83\uC740 \uCD5C\uACE0\uC758 \uB9C8\uBC95\uC785\uB2C8\uB2E4."
    - "\uD074\uB9AC\uC5B4. \uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\uB85C \uC774\uB3D9\uD569\uC2DC\uB2E4."
    - "\uB3D9\uB8CC\uAC00 \uC788\uC73C\uB2C8\uAE4C, \uB450\uB835\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - dialogueType: 3
    text:
    - "\uB808\uBCA8 \uC5C5. \uACBD\uD5D8\uCE58\uB97C \uB9CE\uC774 \uD68D\uB4DD\uD588\uC2B5\uB2C8\uB2E4."
    - "\uC120\uC0DD\uB2D8, \uC9C0\uAE08 \uC544\uB9AC\uC2A4\uB294 \uC774 \uC138\uACC4
      \uCD5C\uAC15\uC758 \uC804\uC0AC\uC785\uB2C8\uB2E4."
    - "\uBAA8\uB450\uB97C \uB9CC\uB098 \uAC8C\uC784\uACFC \uC6B0\uC815\uC744 \uBC30\uC6E0\uC2B5\uB2C8\uB2E4.
      \uC120\uC0DD\uB2D8\uC740 \uC544\uB9AC\uC2A4\uC5D0\uAC8C \uBB34\uC5C7\uC744
      \uAC00\uB974\uCCD0 \uC8FC\uC2E4 \uAC81\uB2C8\uAE4C?"
    - "\uBD10\uC8FC\uC138\uC694, \uC120\uC0DD\uB2D8. \uC544\uB9AC\uC2A4\uB294 \uC774\uC81C
      \uC6C3\uB294\uB2E4\uB294 \uAC83\uC744 \uC774\uD574\uD560 \uC218 \uC788\uAC8C
      \uB410\uC2B5\uB2C8\uB2E4!"
    - "\uC774\uAC83\uC774\u2026\uC804\uC124\uC758 \uC131\uAC80\u2026 \uC544, \uCD1D\uC774\uB124\uC694"
    - "\uD734\uC2DD\uC740 \uC911\uC694\uD569\uB2C8\uB2E4. HP\uAC00 \uD68C\uBCF5\uB418\uB2C8\uAE4C\uC694."
    - "\uB610 \uC120\uC0DD\uB2D8\uACFC \uB808\uC774\uB4DC\uB97C \uB6F0\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4.
      \uACC4\uC815\uC5D0 \uB300\uD654\uB97C \uAC78\uC5B4\uBD10\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uC544\uB9AC\uC2A4\uB97C \uC4F0\uB2F4\uC4F0\uB2F4 \uD574\uC8FC\uC138\uC694.
      \uC544\uB9AC\uC2A4\uC758 \uC778\uACF5 \uB2E8\uBC31\uC9C8 \uD53C\uBD80\uAC00
      \uB530\uB73B\uD574\uC9D1\uB2C8\uB2E4."
    - "\uC544\uB9AC\uC2A4\uB3C4 \uCEE4\uD53C\uAC00 \uB9C8\uC2DC\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
  - dialogueType: 4
    text:
    - "\uC544\uB9AC\uC2A4\uB3C4 \uC120\uC0DD\uB2D8\uC758 \uD638\uAC10\uB3C4\uB97C
      \uB192\uC774\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    - "\uC120\uC0DD\uB2D8\uACFC \uB9CC\uB098\uC11C\u2026\uC544\uB9AC\uC2A4\uB294
      \uD589\uBCF5\uD569\uB2C8\uB2E4."
    - "\uC2E0\uC791 \uAC8C\uC784\uC744 \uCC98\uC74C\uC73C\uB85C \uB9C8\uC8FC\uD560
      \uB54C\u2026\uB808\uBCA8\uC744 \uC62C\uB824 \uC7A5\uBE44 \uAC15\uD654\uC5D0
      \uC131\uACF5\uD560 \uB54C\u2026 \uC120\uC0DD\uB2D8\uACFC \uB9CC\uB0A0 \uB54C
      \uC544\uB9AC\uC2A4\uB294 \uBC94\uC8FC\uD654\uD560 \uC218 \uC5C6\uB294 \uC774\uC0C1\uD55C
      \uAC10\uAC01\uC744 \uB290\uB08D\uB2C8\uB2E4."
    - "\uC120\uC0DD\uB2D8\uACFC \uC811\uCD09\uD558\uACE0 \uB098\uC11C \uC544\uB9AC\uC2A4\uC758
      \uB0B4\uBD80\uC5D0\uC11C \uBB54\uAC00\uAC00 \uD504\uB85C\uADF8\uB798\uBC0D\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC218\uCE58\uB85C \uD658\uC0B0\uD560 \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C
      \uCEE4\uB2E4\uB780\u2026 \uC774 \uAC10\uC815\uC758 \uC774\uB984\uC740\u2026"
  - dialogueType: 5
    text:
    - "\uC544\uB9AC\uC2A4\uB294 \uD0A4\uBCF4\uD1A0\uC2A4\uC5D0"
    - "\uB9C8\uBC95\uC774 \uC5C6\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    - "\uB9C8\uBC95\uC740 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uC120\uC0DD\uB2D8\uC740 \uC9C0\uAE08"
    - "\uC544\uB9AC\uC2A4\uB97C \uD589\uBCF5\uD558\uAC8C \uB9CC\uB4E4\uC5C8\uC73C\uB2C8\uAE4C\uC694."
    - "\uAC8C\uC784\uC774 \uC7AC\uBBF8\uC788\uB294 \uC774\uC720\uB294"
    - "\uADF8\uAC83\uC774 \uC774 \uC138\uC0C1\uC758 \uC544\uB984\uB2E4\uC6C0\uC744"
    - "\uB2F4\uACE0 \uC788\uAE30 \uB54C\uBB38\uC784\uC744"
    - "\uC120\uC0DD\uB2D8\uC744 \uD1B5\uD574 \uC54C\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uAC8C\uC784\uB3C4, \uACE0\uC591\uC774\uB3C4, \uCE5C\uAD6C\uB4E4\uB3C4\u2026"
    - "\uADF8\uB9AC\uACE0 \uC774 \uC21C\uAC04\uB3C4."
    - "\uC774 \uC138\uC0C1\uC5D0\uB294 \uC544\uB984\uB2E4\uC6B4 \uAC83\uB4E4\uC774
      \uB9CE\uC2B5\uB2C8\uB2E4."
    - "\uC544\uB9AC\uC2A4\uB294 \uB354 \uC54C\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    - "\uC120\uC0DD\uB2D8\uACFC \uD568\uAED8\u2026"
    - "\uC774 \uC138\uC0C1\uC744 \uB354 \uBC30\uC6B0\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4!"
  - dialogueType: 6
    text:
    - 101110001101101110111011111....
